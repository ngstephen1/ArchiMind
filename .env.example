# Template only: ArchiMind does not automatically load .env files.
# No API key is needed for the default app, fixture styling or offline demos/tests.
OPENAI_API_KEY=replace_with_your_own_key

# Optional 07B API interpretation: disabled until explicitly enabled in the environment.
# A separate per-call allow_live authorization is also required.
ARCHIMIND_ENABLE_OPENAI_REQUIREMENTS=0
ARCHIMIND_OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Optional C1 advice/C2 workflow node. Live workflow use also requires
# use_ai_layout=True and per-call allow_live_layout=True; default path skips it.
ARCHIMIND_ENABLE_OPENAI_LAYOUT=0

# Optional D1 critique/D2 workflow node. Live workflow use additionally requires
# use_ai_critic=True and exact per-call allow_live_critic=True.
# Standalone live use requires allow_live_usage=True; demos/tests remain mocked.
ARCHIMIND_ENABLE_OPENAI_CRITIC=0

# Optional E1 adapter / E2 final workflow / 07F selected-layout styling panel.
# API use requires explicit opt-in and per-call authorization. The UI consumes
# its authorization checkbox on every attempt; a toggle alone cannot enable API use.
# Demos/tests always use mocked clients. This template is not loaded automatically.
ARCHIMIND_ENABLE_OPENAI_STYLIST=0

# Optional single design agent (chat panel). scripts/run_with_agent.py turns this on
# and reads only OPENAI_API_KEY and ARCHIMIND_OPENAI_MODEL from .env. The panel also
# needs the user's consent checkbox before any message is sent.
ARCHIMIND_ENABLE_OPENAI_AGENT=0

# Optional C01 remains separate and disabled.
ARCHIMIND_ENABLE_CODEX_ADVISOR=0
